# Configuración de la base de datos MongoDB
MONGO_URI=mongodb+srv://tu_usuario:tu_contraseña@tu_cluster.mongodb.net/my_best_friend?retryWrites=true&w=majority

# Configuración JWT
JWT_SECRET=tu_clave_secreta_muy_segura_aqui_cambiala_en_produccion
JWT_EXPIRES_IN=7d

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=development

# Configuración de archivos (para futuro uso con Cloudinary o AWS S3)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Configuración de email (para notificaciones futuras)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_app_password
EMAIL_SERVICE= # (opcional) ej: gmail, outlook. Si defines esto puedes omitir EMAIL_HOST/EMAIL_PORT
EMAIL_SECURE=0 # usa 1 para forzar conexión segura (puerto 465 normalmente)
EMAIL_TLS_REJECT_UNAUTHORIZED=1 # pon 0 SOLO en desarrollo si obtienes error de self-signed certificate
SHOW_DEV_RESET_CODE=0 # pon 1 sólo en desarrollo si quieres que el backend incluya el código en la respuesta JSON